# Pedidos360 - Variables de entorno de ejemplo
# Copia este archivo a .env y completa los valores.
# NUNCA agregues valores reales a este archivo ni lo commitees con datos.

# ---- AWS ----
AWS_REGION=
AWS_ACCOUNT_ID=

# ---- Base de datos (AWS RDS) ----
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ---- Microsoft Entra ID (Azure AD) ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_API_CLIENT_ID=

# ---- URLs internas de microservicios (perfil aws) ----
PEDIDOS_SERVICE_URL=
PRODUCTOS_SERVICE_URL=

# ---- Spring ----
SPRING_PROFILES_ACTIVE=local

# ---- RabbitMQ (broker local via Docker Compose) ----
# Credenciales guest/guest: solo desarrollo local, nunca en AWS.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

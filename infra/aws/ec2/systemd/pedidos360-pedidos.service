[Unit]
Description=Pedidos360 pedidos service
After=network.target

[Service]
User=pedidos360
Group=pedidos360
WorkingDirectory=/opt/pedidos360/pedidos
EnvironmentFile=/etc/pedidos360/pedidos.env
ExecStart=/usr/bin/java -jar /opt/pedidos360/pedidos/pedidos-service.jar
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target